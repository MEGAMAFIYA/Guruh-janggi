modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[userenv]

[userenv.shared]
# Set real values via Replit Secrets, not here — this file is committed to
# git, so anything placed here (e.g. a real admin's Telegram ID) is public.
ADMIN_TELEGRAM_IDS = ""
NODE_ENV = "development"
WEBAPP_BASE_URL = "https://example.com"
