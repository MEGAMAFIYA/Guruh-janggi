# ============================================================
# TELEGRAM GAME PLATFORM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Telegram ---
# Get from @BotFather on Telegram
BOT_TOKEN=

# Webhook URL for production (e.g. https://your-app.onrender.com)
# Leave empty to use long-polling (local dev)
WEBHOOK_URL=https://guruh-janggi.onrender.com

# Secret path for webhook endpoint (random string for security)
WEBHOOK_SECRET=

# --- Admin Access ---
# Comma-separated Telegram user IDs of global bot admins
# e.g. ADMIN_TELEGRAM_IDS=
ADMIN_TELEGRAM_IDS=

# --- Database ---
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/gameplatform
# Render: provided automatically via environment
DATABASE_URL=

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Security ---
# Random secret used to sign session tokens
SESSION_SECRET=

# --- Web App ---
# Base URL where THIS server is publicly reachable (used for CORS, and to
# build each game's webAppUrl — e.g. Katapulta is served at
# ${WEBAPP_BASE_URL}/games/katapulta/index.html by this same server).
# e.g. https://guruh-janggi.onrender.com
# NOTE: this is NOT the same as a t.me/... BotFather Mini App shortcut link —
# it must be the real HTTPS URL of this deployed server.
WEBAPP_BASE_URL=https://example.com