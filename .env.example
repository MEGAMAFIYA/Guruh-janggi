# ============================================================
# TELEGRAM GAME PLATFORM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Telegram ---
# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Webhook URL for production (e.g. https://your-app.onrender.com)
# Leave empty to use long-polling (local dev)
WEBHOOK_URL=

# Secret path for webhook endpoint (random string for security)
WEBHOOK_SECRET=change_me_to_random_string

# --- Admin Access ---
# Comma-separated Telegram user IDs of global bot admins
# e.g. ADMIN_TELEGRAM_IDS=123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Database ---
# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/gameplatform
# Render: provided automatically via environment
DATABASE_URL=postgresql://user:password@localhost:5432/gameplatform

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Security ---
# Random secret used to sign session tokens
SESSION_SECRET=change_me_to_a_long_random_string

# --- Web App ---
# Base URL where Mini Apps are served (used for CORS and URL validation)
# e.g. https://your-miniapp.example.com
WEBAPP_BASE_URL=https://example.com
